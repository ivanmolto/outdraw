#!/bin/sh
# Block commits that contain secrets. Enable once per clone:
#   git config core.hooksPath .githooks
# An editor launched from the Dock runs git with a bare PATH: look where Homebrew installs.
PATH="$PATH:/opt/homebrew/bin:/usr/local/bin"
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks not found; install it with: brew install gitleaks" >&2
  exit 1
fi

exec gitleaks git --pre-commit --staged --redact --no-banner .
