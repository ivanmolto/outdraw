{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://outdraw.live/schemas/CrowdProfile.schema.json",
  "title": "CrowdProfile",
  "description": "Aggregate taste profile of a venue's crowd, built from Qloo data.",
  "type": "object",
  "properties": {
    "venue_id": {
      "type": "string",
      "minLength": 1
    },
    "qloo_venue_id": {
      "type": "string",
      "minLength": 1
    },
    "signals": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Signal"
      }
    },
    "genres": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ProfileItem"
      }
    },
    "related_artists": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ProfileItem"
      }
    },
    "places": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ProfileItem"
      }
    },
    "films": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ProfileItem"
      }
    },
    "brands": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ProfileItem"
      }
    },
    "demographics": {
      "type": "object",
      "description": "Aggregate audience demographics as returned by audience_demographics.",
      "additionalProperties": true
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "EvidenceRef.schema.json"
      }
    },
    "data_quality": {
      "$ref": "#/$defs/DataQuality"
    },
    "notes": {
      "type": "array",
      "description": "Why the profile is less than complete: skipped acts, non-ok envelope summaries.",
      "items": {
        "type": "string"
      },
      "default": []
    }
  },
  "required": [
    "venue_id",
    "signals",
    "genres",
    "related_artists",
    "places",
    "films",
    "brands",
    "evidence",
    "data_quality"
  ],
  "additionalProperties": false,
  "$defs": {
    "Signal": {
      "title": "Signal",
      "description": "Weighted seed entity (e.g. a past act) used for taste calls.",
      "type": "object",
      "properties": {
        "entity_id": {
          "type": "string",
          "minLength": 1
        },
        "weight": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "entity_id",
        "weight"
      ],
      "additionalProperties": false
    },
    "ProfileItem": {
      "title": "ProfileItem",
      "description": "An entity in one of the profile's lists.",
      "type": "object",
      "properties": {
        "entity_id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string"
        },
        "affinity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "entity_id",
        "name"
      ],
      "additionalProperties": false
    },
    "DataQuality": {
      "title": "DataQuality",
      "type": "string",
      "enum": [
        "ok",
        "partial",
        "degraded"
      ]
    }
  }
}
