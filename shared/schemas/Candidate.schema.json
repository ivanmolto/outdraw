{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://outdraw.live/schemas/Candidate.schema.json",
  "title": "Candidate",
  "description": "An act Qloo surfaced as a possible booking.",
  "type": "object",
  "properties": {
    "entity_id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string"
    },
    "popularity": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "affinity": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "EvidenceRef.schema.json"
      }
    }
  },
  "required": [
    "entity_id",
    "name",
    "popularity",
    "affinity",
    "tags",
    "evidence"
  ],
  "additionalProperties": false
}
