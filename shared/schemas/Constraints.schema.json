{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://outdraw.live/schemas/Constraints.schema.json",
  "title": "Constraints",
  "description": "Booking constraints parsed from the user's request.",
  "type": "object",
  "properties": {
    "include_tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "exclude_tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "size_tier": {
      "$ref": "#/$defs/SizeTier"
    },
    "exclude_recent_months": {
      "type": "integer",
      "minimum": 0
    },
    "max_candidates": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50
    }
  },
  "required": [
    "include_tags",
    "exclude_tags",
    "size_tier",
    "exclude_recent_months",
    "max_candidates"
  ],
  "additionalProperties": false,
  "$defs": {
    "SizeTier": {
      "title": "SizeTier",
      "type": "string",
      "enum": [
        "emerging",
        "mid",
        "established"
      ]
    }
  }
}
