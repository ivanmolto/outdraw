ANTHROPIC_API_KEY=...
ANTHROPIC_MODEL=...
# Qloo (agent only; the key is read by the harness from the environment or `qloo setup --qloo`)
QLOO_API_KEY=...
QLOO_BASE_URL=https://hackathon.api.qloo.com
QLOO_TRUSTED_BASE_URL=https://hackathon.api.qloo.com
QLOO_RECORD=0          # 1 writes redacted per-call recordings to agent/recordings/<date>/
QLOO_DAILY_CAP=300     # hard stop on harness spawns per UTC day (no-op without REDIS_URL)
QLOO_CONCURRENCY=3     # parallel harness processes
REDIS_URL=             # daily counter; unset = counter off
DATABASE_URL=          # qloo_cache + qloo_calls tables; unset = in-memory cache
