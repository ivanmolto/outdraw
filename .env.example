# Copy to .env.local (gitignored) and fill in. Keys are server-side only; never NEXT_PUBLIC_.
# The agent does not load this file itself: `set -a && source .env.local && set +a` first.

# Shared secret the web server sends as X-Draw-Internal-Key; every agent route but /health
# requires it and fails closed when unset. Generate with `openssl rand -hex 32`.
INTERNAL_API_KEY=...

# Anthropic (agent)
ANTHROPIC_API_KEY=...
ANTHROPIC_MODEL=claude-haiku-5-5   # the agent's model; Haiku 5.5 is the default
LLM_DAILY_TOKEN_CAP=2000000        # agent tokens per UTC day, Redis key draw:llm:<date> (no-op without REDIS_URL)

# Redis (Upstash, free tier). REDIS_URL is the TLS URL (rediss://) the agent's daily counters
# use; the REST pair is for the web rate limiter on Vercel and is unused by the agent.
REDIS_URL=                         # rediss://default:<password>@<db>.upstash.io:6379; unset = counters off
UPSTASH_REDIS_REST_URL=            # https://<db>.upstash.io
UPSTASH_REDIS_REST_TOKEN=...

# Qloo (agent only). Locally the harness reads the key from ~/.qloo/config (`qloo setup --qloo`),
# so these can stay unset; the Render container has no config file and needs all three.
QLOO_API_KEY=...
QLOO_BASE_URL=https://hackathon.api.qloo.com
QLOO_TRUSTED_BASE_URL=https://hackathon.api.qloo.com
QLOO_RECORD=0                      # 1 writes redacted per-call recordings to agent/recordings/<date>/
QLOO_DAILY_CAP=300                 # hard stop on harness spawns per UTC day, key draw:qloo:<date> (no-op without REDIS_URL)
QLOO_JUDGING_RESERVE=2000          # scripts/precompute.py aborts if remaining quota minus its estimate would fall below this
QLOO_CONCURRENCY=3                 # parallel harness processes

# Web (optional, for scripts/precompute.py): after a rebuild the script POSTs
# {WEB_URL}/api/seeds/revalidate with INTERNAL_API_KEY so the cached seed pages refresh at once.
WEB_URL=                           

# Postgres (Neon or Supabase, pgvector)
DATABASE_URL=                      # qloo_cache + qloo_calls tables; unset = in-memory cache
