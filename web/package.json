{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "clean": "rm -rf .next",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:types": "node scripts/gen-types.mjs",
    "gen:api": "openapi-typescript ../shared/openapi.json -o types/api.ts",
    "test:e2e": "playwright test",
    "check:seeds": "tsx scripts/check-seeds.mts"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@sentry/nextjs": "11.7.0",
    "@upstash/ratelimit": "2.2.0",
    "@upstash/redis": "1.39.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "jsdom": "^30.1.3",
    "json-schema-to-typescript": "16.0.0",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
