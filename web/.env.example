# Copy to web/.env.local (gitignored) and fill in. Server-side only: never give these the
# public prefix, which would inline them into the browser bundle. The browser reaches the
# agent only through the /api route handlers, which read these on the server.

# Base URL of the agent service on Render (T16), no trailing slash.
AGENT_URL=http://localhost:8000

# Same value as the agent's INTERNAL_API_KEY; sent as X-Draw-Internal-Key.
INTERNAL_API_KEY=...
